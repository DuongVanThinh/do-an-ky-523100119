<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Quản lý sản phẩm</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h1>QUẢN LÝ SẢN PHẨM</h1>

    <div class="admin-actions">

    <a
        href="/admin"
        class="admin-btn admin-btn-back"
    >
        ← Quay lại Dashboard
    </a>    

    <a
        href="/admin/products/create"
        class="admin-btn admin-btn-add"
    >
        + Thêm sản phẩm
    </a>

</div>


    <% if (products && products.length > 0) { %>

        <table border="1" cellpadding="10" cellspacing="0">

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>

            </thead>


           <tbody>

<% products.forEach(product => { %>

    <tr>

        <td>
            <%= product.product_id %>
        </td>

        <td>

            <% if (product.image_url) { %>

                <img
                    src="/images/<%= product.image_url %>"
                    alt="<%= product.product_name %>"
                    style="
                        width: 90px;
                        height: 70px;
                        object-fit: cover;
                        border-radius: 5px;
                    "
                >

            <% } else { %>

                <span>Chưa có ảnh</span>

            <% } %>

        </td>

        <td>
            <%= product.product_name %>
        </td>

        <td>
            <%= Number(product.price).toLocaleString("vi-VN") %> đ
        </td>

        <td>
            <%= product.stock_quantity %>
        </td>

        <td>

            <% if (product.is_active) { %>

                <span>Đang kinh doanh</span>

            <% } else { %>

                <strong>Ngừng kinh doanh</strong>

            <% } %>

        </td>

        <td>

            <a href="/admin/products/edit/<%= product.product_id %>">
                Sửa
            </a>

            <% if (product.is_active) { %>

                <form
                    action="/admin/products/<%= product.product_id %>/deactivate"
                    method="POST"
                    style="display:inline;"
                >
                    <button type="submit">
                        Ngừng bán
                    </button>
                </form>

            <% } else { %>

                <form
                    action="/admin/products/<%= product.product_id %>/activate"
                    method="POST"
                    style="display:inline;"
                >
                    <button type="submit">
                        Bán lại
                    </button>
                </form>

            <% } %>

        </td>

    </tr>

<% }); %>

</tbody>

        </table>


    <% } else { %>

        <p>Chưa có sản phẩm nào.</p>

    <% } %>

</div>
</body>
<div class="admin-container"></div>

</html>