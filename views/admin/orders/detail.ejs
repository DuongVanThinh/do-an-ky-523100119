<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Chi tiết đơn hàng - NỘI THẤT HOME
    </title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="admin-container">

    <h1>CHI TIẾT ĐƠN HÀNG</h1>

    <p>
        <a href="/admin/orders">
            ← Quay lại danh sách đơn hàng
        </a>
    </p>

    <hr>

    <h2>
        Đơn hàng #<%= order.order_id %>
    </h2>

    <p>
        <strong>Người nhận:</strong>

        <%= order.receiver_name %>
    </p>

    <p>
        <strong>Số điện thoại:</strong>

        <%= order.phone %>
    </p>

    <p>
        <strong>Địa chỉ:</strong>

        <%= order.shipping_address %>
    </p>

    <p>
        <strong>Trạng thái:</strong>

        <%= order.status %>
    </p>

    <p>
        <strong>Tổng tiền:</strong>

        <%= Number(order.total_amount || 0)
            .toLocaleString("vi-VN") %> đ
    </p>

    <hr>

    <h2>Sản phẩm trong đơn hàng</h2>

    <table
        border="1"
        cellpadding="10"
        cellspacing="0"
        width="100%"
    >

        <thead>

        <tr>
            <th>Sản phẩm</th>

            <th>Số lượng</th>

            <th>Đơn giá</th>

            <th>Thành tiền</th>
        </tr>

        </thead>

        <tbody>

        <% items.forEach(item => { %>

            <tr>

                <td>
                    <%= item.product_name %>
                </td>

                <td>
                    <%= item.quantity %>
                </td>

                <td>
                    <%= Number(item.unit_price || 0)
                        .toLocaleString("vi-VN") %> đ
                </td>

                <td>
                    <%= Number(
                        item.quantity * item.unit_price
                    ).toLocaleString("vi-VN") %> đ
                </td>

            </tr>

        <% }); %>

        </tbody>

    </table>

</div>

</body>
</html>
<div class="admin-order-actions">

    <h3>Cập nhật trạng thái đơn hàng</h3>

    <% if (order.status === "Chờ xác nhận") { %>

        <form
            action="/admin/orders/<%= order.order_id %>/confirm"
            method="POST"
        >

            <button type="submit">
                Xác nhận đơn hàng
            </button>

        </form>

    <% } %>


    <% if (order.status === "Đã xác nhận") { %>

        <form
            action="/admin/orders/<%= order.order_id %>/shipping"
            method="POST"
        >

            <button type="submit">
                Bắt đầu giao hàng
            </button>

        </form>

    <% } %>


    <% if (order.status === "Đang giao") { %>

        <form
            action="/admin/orders/<%= order.order_id %>/complete"
            method="POST"
        >

            <button type="submit">
                Hoàn thành đơn hàng
            </button>

        </form>

    <% } %>

</div>